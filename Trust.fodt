   <text:list text:style-name="List_20_1">
    <text:list-item>
     <text:p text:style-name="P2"><text:span text:style-name="T1">E</text:span>mpezamos con el script dedicado a Nmap que forma parte de mi pequeña suite personal de All4me.sh.</text:p>
     <text:p text:style-name="P2"/>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P3">Primero un rápido análisis de todos los puertos: nmap -sS -O -p- --open -n -Pn -T4 172.17.0.2</text:p>
